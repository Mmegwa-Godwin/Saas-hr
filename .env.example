# Copy this into your environment before running locally.
# The app will fall back to a local development secret if not set.

FLASK_ENV=development
SAAS_HR_SECRET_KEY=change-me-in-local-dev
SAAS_HR_BASE_URL=http://127.0.0.1:5000

# Optional mail configuration for password resets
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=your-email@gmail.com
