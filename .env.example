# Local development template. Never commit real secrets.
FLASK_ENV=development
SAAS_HR_SECRET_KEY=change-me-in-local-dev
SAAS_HR_BASE_URL=http://127.0.0.1:5000

# Optional SMTP settings for password-reset emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=your-email@gmail.com

# In production, configure real values in the hosting provider's
# environment settings. Use the public HTTPS application URL.
